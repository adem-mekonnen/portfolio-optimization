# ── GMF Investments — environment variables ───────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# The .env file is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ──────────────────────────────────────────────────────────────────

# URL the browser uses to reach the FastAPI backend.
# Default (direct port): the browser hits the backend container directly.
# Alternative (nginx proxy): set to http://localhost/api
VITE_API_URL=http://localhost:8000

# ── Backend ───────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call the API.
# Add your production domain here when deploying.
# Default covers local development (Vite dev server + nginx preview).
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Directory where trained LSTM models (.keras) and scalers (.pkl) are stored.
# Override this in Docker or production to point to a persistent volume.
# MODELS_DIR=/app/models

# TensorFlow log verbosity (0=all, 1=no INFO, 2=no WARNING, 3=no ERROR).
TF_CPP_MIN_LOG_LEVEL=3

# Disable oneDNN custom ops (reduces log noise on CPU-only deployments).
TF_ENABLE_ONEDNN_OPTS=0
